# BotHive by ssrjkk — Multi-Bot Orchestrator
# Database
# `connection_limit` bounds each service's Prisma pool so a scaled worker fleet
# cannot exhaust Postgres connections (default pool is CPU-based and can be large).
# The compose stack publishes Postgres to 127.0.0.1:5433 (see docker-compose.yml),
# so local dev uses 5433; the container-internal URL is postgres:5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bothive?connection_limit=10

# Redis
# The compose stack publishes Redis to 127.0.0.1:6380 (see docker-compose.yml).
REDIS_URL=redis://localhost:6380
# Optional. Set to require a password on the Redis server and have the API and
# workers authenticate (docker-compose starts redis with `--requirepass`).
# REDIS_PASSWORD=
# Optional. Redis Sentinel high availability. When REDIS_SENTINELS is set, the
# main REDIS_URL is ignored and connections go through Sentinel.
# Format: host:port[,host:port,...]  e.g. redis://172.18.0.2:26379,redis://172.18.0.3:26379
# REDIS_SENTINELS=
# Optional. Sentinel master name (defaults to "mymaster" when sentinels are set).
# REDIS_SENTINEL_NAME=mymaster
# Optional. Set to 'true' to connect to Redis over TLS (REDIS_URL scheme
# redis:// with tls:true, or rediss://).
# REDIS_TLS=
# Optional. Numeric Redis logical database index to select for all connections.
# REDIS_DB=

# Encryption key for stored tokens (AES-256-GCM). REQUIRED — the API refuses to
# start without a strong key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing it later makes previously stored credentials undecryptable.
# For key rotation, use ENCRYPTION_KEYS with versioned keys (see docs/security.md).
ENCRYPTION_KEY=
# Optional. Multi-key support for rotation. Format: "v1:old-key,v2:new-key".
# Last entry is the current encryption key; earlier entries decrypt legacy data.
# When set, overrides ENCRYPTION_KEY. Use POST /api/backup/rotate-encryption to re-encrypt.
# ENCRYPTION_KEYS=

# Pepper for password hashing (scrypt). REQUIRED in production. Generate a long random string.
PASSWORD_PEPPER=

# JWT secret for admin panel auth. REQUIRED — the API refuses to start with defaults.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# API
API_PORT=3000
API_HOST=0.0.0.0

# Cleartext HTTP/2 (h2c). OFF by default: h2c accepts only h2c prior-knowledge
# clients, so enabling it breaks HTTP/1.1 (nginx proxy, healthchecks, WebSocket)
# unless a TLS-terminating LB in front of the API speaks h2c.
# API_HTTP2=false

# Requests allowed per IP per rate-limit window, applied globally by the API
# (default 300). Lower it if the API is exposed to the public internet.
# API_RATE_LIMIT=300

# Force the Secure flag on auth cookies. This is already automatic when
# NODE_ENV=production; set it explicitly when terminating TLS in front of the API
# while NODE_ENV is not production.
# COOKIE_SECURE=

# Standard Node environment. 'production' also enables Secure cookies and
# suppresses development-only behaviour. Set it in every deployed container.
# NODE_ENV=production

# Version this process reports to Sentry (release tag) and in its worker
# heartbeat. The released Docker images bake their git tag in, so only set this
# when deploying without them (e.g. a bare-metal or custom-image deploy).
# Without it the service reports "dev".
# SERVICE_VERSION=v1.2.3

# Log level (trace | debug | info | warn | error)
LOG_LEVEL=info

# Delete logs older than this many days (periodic cleanup)
LOG_RETENTION_DAYS=30

# Set to 'false' to disable public registration. Registration only ever creates
# the first admin (it is closed as soon as a user exists) — disable when
# admins are managed via the dashboard instead.
ALLOW_REGISTRATION=true

# Allowed CORS origins (comma-separated). '*' allows any origin.
# Same-origin deployments (dashboard behind a proxy) do not need this.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to 'true' when running behind a trusted reverse proxy (nginx/traefik).
# This makes request.ip respect X-Forwarded-For (needed for correct rate limiting).
# Leave unset when the API is exposed directly to avoid IP spoofing.
TRUST_PROXY=

# Set to 'true' to include error stack traces in API error responses. Keep
# unset in production — stack traces leak internals to clients.
EXPOSE_ERROR_STACK=

# Bearer token required to scrape /metrics. Leave empty to disable the token check
# (falls back to JWT auth; set METRICS_OPEN=true to leave /metrics fully open).
# docker-compose defaults this to `bothive-local` so the bundled Prometheus can
# scrape the API out of the box — override with a strong random value.
METRICS_TOKEN=

# Set to 'true' to serve /metrics with no authentication at all. Only for a
# network-isolated scrape path — anyone who can reach the port sees every metric.
# Leave unset in production; METRICS_TOKEN or JWT auth applies instead.
# METRICS_OPEN=

# How long to wait while collecting metrics before responding (default 3000 ms).
# Raise it if a slow scrape returns partial data under load.
# METRICS_TIMEOUT_MS=3000

# ── Alert notifications ───────────────────────────────────────────────────────
# The webhook-receiver service forwards page-severity alerts to these channels.
# Set one or more to enable real notifications. Leave all unset for local-only logging.

# Telegram: format is "bot_token:chat_id"
# Example: NOTIFY_TELEGRAM=123456:ABCDEF:789012
# NOTIFY_TELEGRAM=

# Slack: incoming webhook URL
# Example: NOTIFY_SLACK=https://hooks.slack.com/services/T00/B00/xxx
# NOTIFY_SLACK=

# Discord: webhook URL
# Example: NOTIFY_DISCORD=https://discord.com/api/webhooks/xxx/yyy
# NOTIFY_DISCORD=

# Generic webhook: any URL that accepts POST with Alertmanager JSON payload
# Example: NOTIFY_WEBHOOK=https://alerts.example.com/webhook
# NOTIFY_WEBHOOK=

# Set to 'true' to allow webhook deliveries to private/loopback addresses.
# Do NOT enable in production — it allows SSRF against internal services.
ALLOW_PRIVATE_WEBHOOK_URLS=

# Set to 'true' to also resolve webhook hostnames and block any that point at
# private/loopback IPs (adds a DNS lookup per delivery).
WEBHOOK_DNS_CHECK=

# Per-bot outbound budget for platform actions: at most OUTBOUND_MAX_PER_WINDOW
# sends per OUTBOUND_WINDOW_MS per bot (defaults 30 per 60000 ms). This is the
# backstop that keeps a runaway script from tripping platform API limits.
# OUTBOUND_MAX_PER_WINDOW=30
# OUTBOUND_WINDOW_MS=60000

# Public base URL the Telegram worker registers webhooks against, e.g.
# https://bots.example.com. Webhook mode fails fast without it; long-polling
# mode (the default) does not need it.
# TELEGRAM_WEBHOOK_BASE_URL=

# Per-owner quotas. New resources are rejected with 429 once a limit is reached
# (defaults: 20 accounts, 50 bots, 30 webhooks per owner).
# QUOTA_MAX_ACCOUNTS=20
# QUOTA_MAX_BOTS=50
# QUOTA_MAX_WEBHOOKS=30

# Crypto trading (only used when a crypto worker runs — see the `crypto` compose
# profile). Default cap for a single order in USDT when a bot does not set
# `maxOrderValueUsdt` itself (default 100). Per-bot daily caps are configured on
# the bot, not here, and are disabled by default.
# CRYPTO_MAX_ORDER_USDT=100

# Sentry error tracking (optional). Leave SENTRY_DSN unset to keep the SDK a
# no-op in the API and workers. Captures API request errors and worker
# script-action failures with bot/script context (see docs/deployment.md).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0        # transaction sampling (0 = off; 0.1 = 10%)
# SENTRY_SAMPLE_RATE=1               # error sampling fraction (0..1)

# OpenTelemetry tracing (optional). Tracing turns on only when one of the
# endpoints below is set; the API and workers then export OTLP spans. Sampling
# defaults to 10% of root spans — set OTEL_TRACES_SAMPLE_RATE=1 for all of them.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_TRACES_SAMPLE_RATE=0.1

# Local AI backends used by the transcription/LLM clients in @bothive/core
# (see docs/ai.md). Only needed if you call those helpers.
# WHISPER_BACKEND=ollama             # ollama | whisper-cpp
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# WHISPER_CPP_URL=http://localhost:8080
# WHISPER_MODEL=whisper

# Grafana (docker-compose)
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=admin   # change before exposing Grafana publicly

# Dashboard
VITE_API_URL=http://localhost:3000

# Enable the React Compiler for dashboard builds (opt-in; slower build, better
# runtime memoization). Off unless set to 'true'.
# ENABLE_REACT_COMPILER=

# Workers (docker-compose passes these to each worker service)
# WORKER_PLATFORMS=telegram,twitch       # platform filter for `npm run dev`
# WORKER_CONCURRENCY=10                  # BullMQ jobs per worker process
# INTERVAL_POLL_MS=30000                 # interval-script polling frequency
