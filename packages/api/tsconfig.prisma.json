{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "prisma/.generated-build",
    "rootDir": "prisma/generated/prisma"
  },
  "include": ["prisma/generated/prisma"]
}
