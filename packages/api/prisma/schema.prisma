generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  platform  String   // telegram | twitch | youtube | twitter | crypto
  token     String?  // encrypted token
  clientId  String?
  secret    String?  // encrypted
  refreshToken String?
  apiKey    String?  // encrypted
  apiSecret String?  // encrypted
  apiKeys   Json?    // encrypted array of { apiKey, apiSecret } pairs (rotation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bots      Bot[]

  @@index([ownerId])
  @@index([platform])
}

model Bot {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  platform    String
  status      String   @default("idle")
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  config      Json?    @default("{}")
  connectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        Log[]
  scripts     Script[]
  webhooks    Webhook[]

  @@index([ownerId])
  @@index([platform, status])
  @@index([accountId])
  @@index([ownerId, platform])
}

model Log {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  level     String   // info | warn | error | debug
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([botId, level])
  @@index([createdAt])
}

model Script {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name      String
  trigger   String   // message | follow | subscribe | donation | comment | interval
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId, trigger])
  @@index([enabled])
}

model Webhook {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  url             String
  events          String[] // message | follow | subscribe | donation | comment | interval | status
  botId           String? // null = all bots (within the owner's tenant)
  bot             Bot?      @relation(fields: [botId], references: [id], onDelete: SetNull)
  secret          String? // optional HMAC secret
  enabled         Boolean   @default(true)
  deliveryCount   Int       @default(0)
  lastStatus      String? // ok | failed
  lastError       String?
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deliveries      WebhookDelivery[]

  @@index([ownerId])
  @@index([botId])
  @@index([enabled])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType  String
  botId      String?
  status     String // ok | failed
  statusCode Int?
  attempt    Int      @default(1)
  error      String?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([webhookId, createdAt])
  @@index([status])
}

model Proxy {
  id            String    @id @default(cuid())
  url           String // encrypted; may contain user:password
  type          String    @default("http") // http | socks5
  priority      Int       @default(0)
  enabled       Boolean   @default(true)
  healthScore   Int       @default(100) // 0-100
  lastFailedAt  DateTime?
  requestsCount Int       @default(0)
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          String   @default("viewer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  bots          Bot[]
  webhooks      Webhook[]
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String   @default("viewer")
  createdById String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
