# ============================================================
# EZOffer — пример конфигурации. Скопируйте в .env и заполните.
# ============================================================

# Публичный домен для sitemap/robots/метаданных.
SITE_URL=http://localhost:3000

# Порт для `next start` (и Docker).
PORT=3000

# ------------------------------------------------------------
# hh.ru — РЕАЛЬНЫЕ отклики на вакансии (OAuth)
# ------------------------------------------------------------
# Создайте приложение на https://dev.hh.ru (раздел «Мои приложения»):
#   Redirect URI: ваш SITE_URL + /api/hh/callback
# Включите права: "Отклики" (negotiations), "Чтение откликов",
# "Чтение вакансий", "Резюме".
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=

# Глобальный токен hh.ru. Нужен ТОЛЬКО для поиска вакансий (GET /vacancies
# отвечает 403 без токена). Обычно не нужен: сервис сам получает токен
# приложения по client_credentials из HH_CLIENT_ID + HH_CLIENT_SECRET и
# кэширует его. Оставьте пустым, если приложение на dev.hh.ru создано.
#
# ВАЖНО: этот токен НЕ используется для отправки откликов. Отклик уходит
# с токена самого пользователя (users.hh_token) — иначе он ушёл бы не от
# того, кому принадлежит.
HH_ACCESS_TOKEN=

# ------------------------------------------------------------
# Каталог вакансий
# ------------------------------------------------------------
# Обновление идёт под активные поиски пользователей: тексты запросов
# берутся из searches, а не берётся общая витрина площадки.
#
# Быстрые источники (hh.ru) обновляем часто — на них держится обещание
# «отклик в первые минуты после публикации». При шестичасовом интервале
# вакансия, опубликованная два часа назад, попадала бы в автоотклик через
# шесть, и обещание было бы невыполнимо по построению.
CATALOG_FAST_TTL_MS=1800000
# Медленные агрегаторы обновляем реже, чтобы не бить по их лимитам.
CATALOG_SLOW_TTL_MS=21600000

# ------------------------------------------------------------
# Автоотклики: мягкие лимиты (защита от блокировок)
# ------------------------------------------------------------
AUTOAPPLY_DAILY_CAP=0
AUTOAPPLY_HOURLY_CAP=12
AUTOAPPLY_MIN_INTERVAL_SEC=45
AUTOAPPLY_MAX_INTERVAL_SEC=180
AUTOAPPLY_WORK_START=9
AUTOAPPLY_WORK_END=20

# Секрет для вызова /api/autoapply/run из внешнего cron.
CRON_SECRET=

# ------------------------------------------------------------
# Telegram-бот (необязательно)
# ------------------------------------------------------------
# Токен бота от @BotFather. Без него бот не отправляет сообщения.
TELEGRAM_BOT_TOKEN=
# Секрет, который BotFather/setWebhook шлёт в заголовке
# X-Telegram-Bot-Api-Secret-Token. Обязателен: без него вебхук не работает.
TELEGRAM_WEBHOOK_SECRET=
# URL для регистрации вебхука: https://<домен>/api/telegram/webhook
# Регистрируется вручную: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<SECRET>

# ------------------------------------------------------------
# Письма (восстановление пароля)
# ------------------------------------------------------------
# Без SMTP_* восстановление пароля не работает: письмо просто не уходит.
# Любой SMTP с поддержкой STARTTLS подойдёт (Mailgun, Yandex, Gmail App Password).
# Порт 465 — implicit TLS, 587 — STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Отправитель в письмах. Если пусто — берётся SMTP_USER.
SMTP_FROM=

# ------------------------------------------------------------
# AI-улучшение резюме и персонализация писем (необязательно)
# ------------------------------------------------------------
# OpenAI-совместимый ключ. Без него используются локальные эвристики.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ------------------------------------------------------------
# Каталог вакансий (источники без ключей)
# ------------------------------------------------------------
# RSS-фиды вакансий компаний (через запятую).
COMPANY_JOB_FEEDS=
# Доски Greenhouse (через запятую, путь = стандартные).
GREENHOUSE_BOARDS=

# ------------------------------------------------------------
# Прочее
# ------------------------------------------------------------
SCHEDULER_INTERVAL_MS=300000
EZOFFER_DB_PATH=
TRUST_PROXY=0
EZOFFER_SILENT=0
