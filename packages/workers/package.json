{
  "name": "@bothive/workers",
  "version": "1.0.0",
  "author": "ssrjkk",
  "type": "module",
  "main": "dist/index.js",
  "description": "BotHive Workers — Telegram, Twitch, YouTube, Twitter bots by ssrjkk",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:telegram": "node dist/index.js --platform telegram",
    "start:twitch": "node dist/index.js --platform twitch",
    "start:youtube": "node dist/index.js --platform youtube",
    "start:twitter": "node dist/index.js --platform twitter",
    "start:crypto": "node dist/index.js --platform crypto",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bothive/core": "*",
    "@grammyjs/auto-retry": "^2.0.2",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "bullmq": "^6.3.0",
    "bullmq-otel": "^2.0.1",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "grammy": "^1.33.0",
    "ioredis": "^6.0.0",
    "tmi.js": "^1.8.5",
    "twitter-api-v2": "^1.29.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
