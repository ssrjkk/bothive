{
  "name": "@bothive/workers",
  "version": "1.0.0",
  "author": "ssrjkk",
  "type": "module",
  "main": "dist/index.js",
  "description": "BotHive Workers — Telegram, Twitch, YouTube, Twitter bots by ssrjkk",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:telegram": "node dist/index.js --platform telegram",
    "start:twitch": "node dist/index.js --platform twitch",
    "start:youtube": "node dist/index.js --platform youtube",
    "start:twitter": "node dist/index.js --platform twitter",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bothive/core": "*",
    "@grammyjs/auto-retry": "^2.0.2",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.8",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.0",
    "grammy": "^1.33.0",
    "ioredis": "^6.0.0",
    "tmi.js": "^1.8.5",
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "twitter-api-v2": "^1.29.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/tmi.js": "^1.8.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
